{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "automerge": true,
  "automergeType": "branch",
  "automergeSchedule": [
    "at any time"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchPackageNames": ["github.com/swaggo/files"],
      "enabled": false
    }
  ]
}
